# Watchman Client Environment Variables
# Copy this file to .env.local for local development.
# Every NEXT_PUBLIC_ variable is baked into the browser bundle at build time.
# Set these in the host (for example Vercel) before building. Do not commit real keys.

# Required. Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required. Supabase anon key (safe to expose in the browser; row-level security still applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional. Newer Supabase publishable key. When set, the client uses it instead of the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Required. Origin of the Watchman API, with no path and no trailing slash.
# There is no built-in default. The UI shows a connection error when this is missing or unreachable.
# Local API: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Required for production sign-in. Public site origin used for Google, magic-link, and email confirmation redirects.
# Add this origin's /auth/callback URL to the Supabase Auth redirect allow list.
NEXT_PUBLIC_SITE_URL=https://trywatchman.app

# Payments provider. paystack (default) keeps Paystack status, verify, and cancel working
# until Stripe is live. Public pricing already shows the Stripe plans. Set stripe and rebuild
# after the billing API and Stripe keys are configured.
# NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe
NEXT_PUBLIC_PAYMENTS_PROVIDER=paystack
